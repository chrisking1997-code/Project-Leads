#!/bin/bash

# ============================================
# LEADS GENERATOR - 一鍵部署腳本
# ============================================

echo "🚀 Leads Generator 部署助手"
echo "======================================"
echo ""

# 顏色定義
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# ============================================
# 1. 檢查環境
# ============================================

echo "📋 步驟 1/6: 檢查本地環境..."

# 檢查 Node.js
if ! command -v node &> /dev/null; then
    echo -e "${RED}❌ Node.js 未安裝${NC}"
    echo "請前往 https://nodejs.org/ 下載安裝"
    exit 1
fi

NODE_VERSION=$(node -v)
echo -e "${GREEN}✅ Node.js: $NODE_VERSION${NC}"

# 檢查 npm
if ! command -v npm &> /dev/null; then
    echo -e "${RED}❌ npm 未安裝${NC}"
    exit 1
fi

NPM_VERSION=$(npm -v)
echo -e "${GREEN}✅ npm: $NPM_VERSION${NC}"

# 檢查 git
if ! command -v git &> /dev/null; then
    echo -e "${RED}❌ git 未安裝${NC}"
    echo "請前往 https://git-scm.com/ 下載安裝"
    exit 1
fi

GIT_VERSION=$(git --version)
echo -e "${GREEN}✅ $GIT_VERSION${NC}"

echo ""

# ============================================
# 2. 創建專案結構
# ============================================

echo "📁 步驟 2/6: 創建專案結構..."

read -p "請輸入專案名稱 (預設: leads-generator): " PROJECT_NAME
PROJECT_NAME=${PROJECT_NAME:-leads-generator}

if [ -d "$PROJECT_NAME" ]; then
    echo -e "${YELLOW}⚠️  資料夾已存在，是否覆蓋？ (y/n)${NC}"
    read -p "> " OVERWRITE
    if [ "$OVERWRITE" != "y" ]; then
        echo "取消部署"
        exit 0
    fi
    rm -rf "$PROJECT_NAME"
fi

mkdir -p "$PROJECT_NAME/backend"
mkdir -p "$PROJECT_NAME/frontend"

echo -e "${GREEN}✅ 專案結構已創建${NC}"
echo ""

# ============================================
# 3. 設定後端
# ============================================

echo "⚙️  步驟 3/6: 設定後端..."

cd "$PROJECT_NAME/backend"

# 創建 package.json
cat > package.json << 'EOF'
{
  "name": "leads-generator-backend",
  "version": "1.0.0",
  "description": "Free Leads Generator API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "axios": "^1.6.0",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}
EOF

# 創建 .gitignore
cat > .gitignore << 'EOF'
node_modules/
.env
.DS_Store
*.log
.vscode/
.idea/
EOF

# 創建 .env 範本
cat > .env.example << 'EOF'
PORT=3001
COMPANIES_HOUSE_API_KEY=your_key_here
HUNTER_API_KEY=your_key_here
CLEARBIT_API_KEY=your_key_here
EOF

echo -e "${YELLOW}⚠️  請稍後編輯 backend/.env 檔案並填入你的 API keys${NC}"

# 安裝依賴
echo "📦 安裝後端依賴..."
npm install --silent

echo -e "${GREEN}✅ 後端設定完成${NC}"
echo ""

cd ../..

# ============================================
# 4. 設定前端
# ============================================

echo "🎨 步驟 4/6: 設定前端..."

cd "$PROJECT_NAME/frontend"

echo "選擇前端框架："
echo "1) Vite + React (推薦，更快)"
echo "2) Create React App (傳統)"
read -p "請選擇 (1/2): " FRAMEWORK_CHOICE

if [ "$FRAMEWORK_CHOICE" = "1" ]; then
    npm create vite@latest . -- --template react
else
    npx create-react-app .
fi

# 安裝 lucide-react
echo "📦 安裝圖示庫..."
npm install lucide-react --silent

# 創建 .env.example
cat > .env.example << 'EOF'
VITE_API_URL=http://localhost:3001/api
EOF

echo -e "${GREEN}✅ 前端設定完成${NC}"
echo ""

cd ../..

# ============================================
# 5. 配置 Git
# ============================================

echo "📝 步驟 5/6: 配置 Git..."

cd "$PROJECT_NAME"

# 初始化 git（如果還沒有）
if [ ! -d ".git" ]; then
    git init
    echo -e "${GREEN}✅ Git repository 已初始化${NC}"
fi

# 創建主 .gitignore
cat > .gitignore << 'EOF'
node_modules/
.env
.DS_Store
*.log
.vscode/
.idea/
dist/
build/
EOF

# 第一次 commit
git add .
git commit -m "Initial commit: Leads Generator setup"

echo -e "${GREEN}✅ Git 配置完成${NC}"
echo ""

# ============================================
# 6. 顯示下一步
# ============================================

echo "✨ 步驟 6/6: 設定完成！"
echo "======================================"
echo ""
echo -e "${GREEN}✅ 專案已成功創建！${NC}"
echo ""
echo "📋 下一步操作："
echo ""
echo "1️⃣  設定 API Keys:"
echo "   cd $PROJECT_NAME/backend"
echo "   cp .env.example .env"
echo "   編輯 .env 檔案，填入你的 API keys"
echo ""
echo "2️⃣  複製後端程式碼:"
echo "   將提供的 server.js 複製到 backend/ 資料夾"
echo ""
echo "3️⃣  複製前端程式碼:"
echo "   將提供的 React 程式碼複製到 frontend/src/App.jsx"
echo ""
echo "4️⃣  測試本地運行:"
echo "   終端機 1:"
echo "   cd $PROJECT_NAME/backend && npm run dev"
echo ""
echo "   終端機 2:"
echo "   cd $PROJECT_NAME/frontend && npm run dev"
echo ""
echo "5️⃣  部署到線上:"
echo "   參考完整部署教學文件"
echo ""
echo "======================================"
echo ""
echo -e "${YELLOW}📚 需要 API Keys？${NC}"
echo "   Companies House: https://developer.company-information.service.gov.uk/"
echo "   Hunter.io: https://hunter.io/users/sign_up"
echo ""
echo -e "${GREEN}🎉 祝你成功！${NC}"
echo ""

# ============================================
# 可選：自動打開瀏覽器
# ============================================

read -p "是否打開 API 註冊頁面？ (y/n): " OPEN_BROWSER

if [ "$OPEN_BROWSER" = "y" ]; then
    if command -v open &> /dev/null; then
        # macOS
        open "https://developer.company-information.service.gov.uk/"
    elif command -v xdg-open &> /dev/null; then
        # Linux
        xdg-open "https://developer.company-information.service.gov.uk/"
    elif command -v start &> /dev/null; then
        # Windows
        start "https://developer.company-information.service.gov.uk/"
    fi
fi

# ============================================
# Windows 版本 (PowerShell)
# ============================================
# 將以下內容儲存為 deploy.ps1

: << 'POWERSHELL_SCRIPT'
# deploy.ps1 - Windows PowerShell 版本

Write-Host "🚀 Leads Generator 部署助手" -ForegroundColor Cyan
Write-Host "======================================" -ForegroundColor Cyan
Write-Host ""

# 檢查 Node.js
if (!(Get-Command node -ErrorAction SilentlyContinue)) {
    Write-Host "❌ Node.js 未安裝" -ForegroundColor Red
    Write-Host "請前往 https://nodejs.org/ 下載安裝"
    exit 1
}

$nodeVersion = node -v
Write-Host "✅ Node.js: $nodeVersion" -ForegroundColor Green

# 檢查 npm
if (!(Get-Command npm -ErrorAction SilentlyContinue)) {
    Write-Host "❌ npm 未安裝" -ForegroundColor Red
    exit 1
}

$npmVersion = npm -v
Write-Host "✅ npm: $npmVersion" -ForegroundColor Green

# 檢查 git
if (!(Get-Command git -ErrorAction SilentlyContinue)) {
    Write-Host "❌ git 未安裝" -ForegroundColor Red
    Write-Host "請前往 https://git-scm.com/ 下載安裝"
    exit 1
}

Write-Host "✅ git 已安裝" -ForegroundColor Green
Write-Host ""

# 創建專案
$projectName = Read-Host "請輸入專案名稱 (預設: leads-generator)"
if ([string]::IsNullOrWhiteSpace($projectName)) {
    $projectName = "leads-generator"
}

if (Test-Path $projectName) {
    $overwrite = Read-Host "資料夾已存在，是否覆蓋？ (y/n)"
    if ($overwrite -ne "y") {
        Write-Host "取消部署"
        exit 0
    }
    Remove-Item -Recurse -Force $projectName
}

New-Item -ItemType Directory -Path "$projectName/backend" -Force | Out-Null
New-Item -ItemType Directory -Path "$projectName/frontend" -Force | Out-Null

Write-Host "✅ 專案結構已創建" -ForegroundColor Green
Write-Host ""

Write-Host "⚙️  設定後端..." -ForegroundColor Yellow
Set-Location "$projectName/backend"

# 創建 package.json
@"
{
  "name": "leads-generator-backend",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "axios": "^1.6.0",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "dotenv": "^16.3.1"
  }
}
"@ | Out-File -FilePath "package.json" -Encoding UTF8

npm install

Write-Host "✅ 後端設定完成" -ForegroundColor Green
Set-Location ../..

Write-Host ""
Write-Host "✨ 設定完成！" -ForegroundColor Green
Write-Host ""
Write-Host "下一步請參考文件繼續操作" -ForegroundColor Yellow
POWERSHELL_SCRIPT

# ============================================
# 部署到 Railway 的腳本
# ============================================

cat > deploy-railway.sh << 'EOF'
#!/bin/bash

echo "🚂 部署到 Railway..."

# 檢查是否安裝 Railway CLI
if ! command -v railway &> /dev/null; then
    echo "安裝 Railway CLI..."
    npm install -g @railway/cli
fi

# 登入
railway login

# 初始化專案
railway init

# 部署
railway up

echo "✅ 部署完成！"
echo "請在 Railway Dashboard 設定環境變數"
EOF

chmod +x deploy-railway.sh

# ============================================
# 部署到 Vercel 的腳本
# ============================================

cat > deploy-vercel.sh << 'EOF'
#!/bin/bash

echo "▲ 部署到 Vercel..."

# 檢查是否安裝 Vercel CLI
if ! command -v vercel &> /dev/null; then
    echo "安裝 Vercel CLI..."
    npm install -g vercel
fi

# 部署
vercel

echo "✅ 部署完成！"
EOF

chmod +x deploy-vercel.sh

echo "📝 額外腳本已創建："
echo "   - deploy-railway.sh (部署後端到 Railway)"
echo "   - deploy-vercel.sh (部署前端到 Vercel)"
