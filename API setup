# ============================================

# ============================================
# PACKAGE.JSON
# ============================================
{
  "name": "leads-generator-free-api",
  "version": "1.0.0",
  "description": "免費 Leads Generator Backend API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "axios": "^1.6.0",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}

# ============================================
# .ENV 檔案配置
# ============================================
PORT=3001

# Companies House API (英國公司資料) - 完全免費，無限制
# 註冊: https://developer.company-information.service.gov.uk/
# 1. 點擊 "Register" 建立帳號
# 2. 登入後到 "Your applications" 
# 3. 點擊 "Create an application"
# 4. 填寫應用名稱和描述
# 5. 複製 API Key
COMPANIES_HOUSE_API_KEY=your_companies_house_key_here

# Hunter.io API (Email 查找) - 免費 25 次/月
# 註冊: https://hunter.io/users/sign_up
# 1. 註冊免費帳號
# 2. 到 Dashboard 點擊 "API" 標籤
# 3. 複製 API Key
# 4. 免費版限制: 25 次搜尋/月，50 次驗證/月
HUNTER_API_KEY=your_hunter_api_key_here

# Clearbit API (公司資訊) - 有限免費
# 註冊: https://clearbit.com/
# 注意: 需要信用卡但不會收費（免費額度內）
CLEARBIT_API_KEY=your_clearbit_key_here

# GitHub 不需要 API Key（但建議創建以增加限制）
# 免費: 60 requests/hour (無認證)
# 有認證: 5000 requests/hour
# 創建 Personal Access Token: https://github.com/settings/tokens

# ============================================
# 安裝步驟
# ============================================

# 1. 創建專案資料夾
mkdir leads-generator-free
cd leads-generator-free

# 2. 初始化 npm
npm init -y

# 3. 安裝依賴
npm install express cors axios helmet express-rate-limit dotenv
npm install --save-dev nodemon

# 4. 創建檔案
# - server.js (主程式)
# - .env (API keys)
# - .gitignore

# 5. 啟動伺服器
npm start

