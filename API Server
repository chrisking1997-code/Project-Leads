// Export to CSV
app.post('/api/leads/export', (req, res) => {
  try {
    const { leads } = req.body;

    if (!leads || !Array.isArray(leads) || leads.length === 0) {
      return res.status(400).json({ 
        error: 'No leads provided for export' 
      });
    }

    const headers = ['Name', 'Job Title', 'Company', 'Industry', 'Location', 'Email', 'Phone', 'LinkedIn', 'Source', 'Match Score'];
    const csvRows = [
      headers.join(','),
      ...leads.map(lead => [
        `"${lead.name || ''}"`,
        `"${lead.jobTitle || ''}"`,
        `"${lead.company || ''}"`,
        `"${lead.industry || ''}"`,
        `"${lead.location || ''}"`,
        lead.email || '',
        `"${lead.phone || ''}"`,
        lead.linkedin || '',
        `"${lead.source || ''}"`,
        lead.matchScore || ''
      ].join(','))
    ];

    const csv = csvRows.join('\n');

    res.setHeader('Content-Type', 'text/csv');
    res.setHeader('Content-Disposition', `attachment; filename=leads-export-${Date.now()}.csv`);
    res.send(csv);

  } catch (error) {
    console.error('Export error:', error);
    res.status(500).json({ 
      error: 'Failed to export leads',
      message: error.message 
    });
  }
});

// ============================================
// 範例資料生成器（後備方案）
// ============================================
function generateSampleLeads(criteria) {
  const industries = ['Technology', 'Finance', 'Healthcare', 'Retail', 'Manufacturing'];
  const companies = ['TechCorp Ltd', 'InnovateLab UK', 'DataSystems Ltd', 'CloudNine UK', 'NextGen Solutions'];
  const firstNames = ['James', 'Sarah', 'Michael', 'Emily', 'David', 'Jessica', 'Robert', 'Lisa'];
  const lastNames = ['Smith', 'Johnson', 'Williams', 'Brown', 'Jones', 'Taylor', 'Miller', 'Davis'];
  const ukLocations = ['London, UK', 'Manchester, UK', 'Birmingham, UK', 'Edinburgh, UK', 'Leeds, UK'];
  
  const sampleLeads = [];
  const count = Math.floor(Math.random() * 8) + 5;
  
  for (let i = 0; i < count; i++) {
    const firstName = firstNames[Math.floor(Math.random() * firstNames.length)];
    const lastName = lastNames[Math.floor(Math.random() * lastNames.length)];
    const company = criteria.company || companies[Math.floor(Math.random() * companies.length)];
    const location = criteria.location || ukLocations[Math.floor(Math.random() * ukLocations.length)];
    
    sampleLeads.push({
      id: `sample-${Date.now()}-${i}`,
      name: `${firstName} ${lastName}`,
      jobTitle: criteria.jobTitle || `${['Senior', 'Lead', 'Chief', 'Head of'][i % 4]} ${['Marketing', 'Sales', 'Technology', 'Operations'][i % 4]}`,
      company: company,
      industry: criteria.industry || industries[Math.floor(Math.random() * industries.length)],
      location: location,
      email: `${firstName.toLowerCase()}.${lastName.toLowerCase()}@${company.toLowerCase().replace(/\s+/g, '').replace('ltd', '')}.co.uk`,
      phone: `+44 ${Math.floor(Math.random() * 90) + 10} ${Math.floor(Math.random() * 9000) + 1000} ${Math.floor(Math.random() * 9000) + 1000}`,
      linkedin: `https://linkedin.com/in/${firstName.toLowerCase()}-${lastName.toLowerCase()}`,
      source: 'Sample Data',
      matchScore: Math.floor(Math.random() * 30) + 70
    });
  }
  
  return sampleLeads;
}

