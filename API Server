// ============================================
// 1. COMPANIES HOUSE API (UK) - 完全免費
// ============================================
async function searchCompaniesHouse(companyName) {
  if (!COMPANIES_HOUSE_API_KEY) {
    console.log('Companies House API key not configured');
    return [];
  }

  try {
    // 搜尋公司
    const searchResponse = await axios.get(
      `https://api.company-information.service.gov.uk/search/companies`,
      {
        params: {
          q: companyName,
          items_per_page: 10
        },
        auth: {
          username: COMPANIES_HOUSE_API_KEY,
          password: ''
        }
      }
    );

    const companies = searchResponse.data.items || [];
    const leads = [];

    // 獲取每家公司的詳細資訊
    for (const company of companies.slice(0, 5)) {
      try {
        // 獲取公司詳情
        const companyDetail = await axios.get(
          `https://api.company-information.service.gov.uk/company/${company.company_number}`,
          {
            auth: {
              username: COMPANIES_HOUSE_API_KEY,
              password: ''
            }
          }
        );

        // 獲取公司高階主管
        const officersResponse = await axios.get(
          `https://api.company-information.service.gov.uk/company/${company.company_number}/officers`,
          {
            auth: {
              username: COMPANIES_HOUSE_API_KEY,
              password: ''
            }
          }
        );

        const officers = officersResponse.data.items || [];
        
        // 為每位高階主管創建潛在客戶
        for (const officer of officers.slice(0, 3)) {
          if (officer.resigned_on) continue; // 跳過已離職的

          const address = officer.address;
          const location = [
            address.locality,
            address.postal_code,
            'United Kingdom'
          ].filter(Boolean).join(', ');

          leads.push({
            id: `ch-${company.company_number}-${officer.name.replace(/\s+/g, '-')}`,
            name: officer.name,
            jobTitle: officer.officer_role || 'Director',
            company: company.title,
            companyNumber: company.company_number,
            industry: companyDetail.data.sic_codes ? 
              getSICDescription(companyDetail.data.sic_codes[0]) : 'Unknown',
            location: location,
            address: formatAddress(address),
            companyStatus: company.company_status,
            companyType: company.company_type,
            incorporationDate: companyDetail.data.date_of_creation,
            email: null, // 需要用其他API補充
            phone: null,
            linkedin: null,
            source: 'Companies House (UK)',
            matchScore: 70
          });
        }
      } catch (error) {
        console.error(`Error fetching details for ${company.company_number}:`, error.message);
      }
    }

    return leads;
  } catch (error) {
    console.error('Companies House API Error:', error.message);
    return [];
  }
}

// ============================================
// 2. HUNTER.IO 免費版 (25次/月)
// ============================================
async function findEmailWithHunter(firstName, lastName, domain) {
  if (!HUNTER_API_KEY) {
    return null;
  }

  try {
    const response = await axios.get('https://api.hunter.io/v2/email-finder', {
      params: {
        domain: domain,
        first_name: firstName,
        last_name: lastName,
        api_key: HUNTER_API_KEY
      }
    });

    if (response.data.data.email) {
      return {
        email: response.data.data.email,
        score: response.data.data.score,
        verified: response.data.data.status === 'valid'
      };
    }
  } catch (error) {
    if (error.response?.status === 429) {
      console.log('Hunter.io rate limit reached (25/month on free tier)');
    }
    return null;
  }

  return null;
}

// 批次查找郵件（使用 Domain Search - 免費版每月25次）
async function findCompanyEmailsHunter(domain) {
  if (!HUNTER_API_KEY) {
    return [];
  }

  try {
    const response = await axios.get('https://api.hunter.io/v2/domain-search', {
      params: {
        domain: domain,
        limit: 10,
        api_key: HUNTER_API_KEY
      }
    });

    return response.data.data.emails || [];
  } catch (error) {
    if (error.response?.status === 429) {
      console.log('Hunter.io monthly limit reached');
    }
    return [];
  }
}

// ============================================
// 3. CLEARBIT API (有限免費)
// ============================================
async function enrichWithClearbit(domain) {
  if (!CLEARBIT_API_KEY) {
    return null;
  }

  try {
    const response = await axios.get(`https://company.clearbit.com/v2/companies/find`, {
      params: { domain: domain },
      headers: {
        'Authorization': `Bearer ${CLEARBIT_API_KEY}`
      }
    });

    return {
      company: response.data.name,
      industry: response.data.category?.industry,
      employees: response.data.metrics?.employees,
      location: response.data.geo?.city + ', ' + response.data.geo?.country,
      description: response.data.description,
      phone: response.data.phone,
      linkedin: response.data.linkedin?.handle,
      twitter: response.data.twitter?.handle
    };
  } catch (error) {
    return null;
  }
}

// ============================================
// 4. GITHUB API (完全免費 - 適合找開發者)
// ============================================
async function searchGitHubDevelopers(query, location) {
  try {
    const searchQuery = `${query} location:${location || 'UK'}`;
    
    const response = await axios.get('https://api.github.com/search/users', {
      params: {
        q: searchQuery,
        per_page: 20
      },
      headers: {
        'Accept': 'application/vnd.github.v3+json',
        'User-Agent': 'Leads-Generator'
      }
    });

    const users = response.data.items || [];
    const leads = [];

    for (const user of users.slice(0, 10)) {
      try {
        // 獲取用戶詳細資訊
        const userDetail = await axios.get(user.url, {
          headers: {
            'Accept': 'application/vnd.github.v3+json',
            'User-Agent': 'Leads-Generator'
          }
        });

        const profile = userDetail.data;

        leads.push({
          id: `gh-${profile.id}`,
          name: profile.name || profile.login,
          jobTitle: profile.bio || 'Developer',
          company: profile.company || 'Independent',
          location: profile.location || 'Unknown',
          email: profile.email,
          github: profile.html_url,
          linkedin: null,
          blog: profile.blog,
          twitter: profile.twitter_username,
          source: 'GitHub',
          followers: profile.followers,
          repositories: profile.public_repos,
          matchScore: 75
        });
      } catch (error) {
        console.error(`Error fetching GitHub user details:`, error.message);
      }
    }

    return leads;
  } catch (error) {
    console.error('GitHub API Error:', error.message);
    return [];
  }
}

// ============================================
// UTILITY FUNCTIONS
// ============================================

function getSICDescription(code) {
  const sicCodes = {
    '62': 'Computer programming, consultancy',
    '63': 'Information service activities',
    '64': 'Financial service activities',
    '70': 'Management consultancy',
    '71': 'Architectural and engineering',
    '72': 'Scientific research',
    '73': 'Advertising and market research',
    '82': 'Office administrative services'
  };
  
  const mainCode = code.substring(0, 2);
  return sicCodes[mainCode] || 'Other';
}

function formatAddress(address) {
  if (!address) return null;
  
  return [
    address.address_line_1,
    address.address_line_2,
    address.locality,
    address.postal_code,
    address.country
  ].filter(Boolean).join(', ');
}

function extractDomainFromCompany(companyName) {
  // 簡單的域名猜測
  const cleaned = companyName
    .toLowerCase()
    .replace(/ltd|limited|plc|inc|corp|llc/gi, '')
    .replace(/[^a-z0-9]/g, '')
    .trim();
  
  return `${cleaned}.co.uk`;
}

function parseFullName(fullName) {
  const parts = fullName.trim().split(/\s+/);
  return {
    firstName: parts[0],
    lastName: parts.slice(1).join(' ') || parts[0]
  };
}

// ============================================
// 主要搜尋邏輯 - 整合所有免費API
// ============================================
async function searchLeadsWithFreeAPIs(criteria) {
  let allLeads = [];

  // 1. 如果是搜尋UK公司 - 使用 Companies House
  if (criteria.company || (criteria.location && criteria.location.includes('UK'))) {
    console.log('Searching Companies House (UK)...');
    
    const companyName = criteria.company || criteria.keywords || 'technology';
    const companiesHouseLeads = await searchCompaniesHouse(companyName);
    
    allLeads = allLeads.concat(companiesHouseLeads);

    // 嘗試用 Hunter.io 補充 email
    if (HUNTER_API_KEY && companiesHouseLeads.length > 0) {
      console.log('Enriching with Hunter.io emails...');
      
      for (const lead of companiesHouseLeads.slice(0, 5)) { // 限制5個避免超過免費額度
        const domain = extractDomainFromCompany(lead.company);
        const { firstName, lastName } = parseFullName(lead.name);
        
        const emailData = await findEmailWithHunter(firstName, lastName, domain);
        if (emailData) {
          lead.email = emailData.email;
          lead.emailScore = emailData.score;
          lead.emailVerified = emailData.verified;
          lead.matchScore += 10;
        }
      }
    }
  }

  // 2. 如果是搜尋開發者 - 使用 GitHub
  if (criteria.jobTitle && 
      (criteria.jobTitle.toLowerCase().includes('developer') || 
       criteria.jobTitle.toLowerCase().includes('engineer') ||
       criteria.jobTitle.toLowerCase().includes('programmer'))) {
    console.log('Searching GitHub...');
    
    const query = criteria.jobTitle || 'developer';
    const githubLeads = await searchGitHubDevelopers(query, criteria.location);
    allLeads = allLeads.concat(githubLeads);
  }

  // 3. 使用 Clearbit 補充公司資訊
  if (CLEARBIT_API_KEY && allLeads.length > 0) {
    console.log('Enriching with Clearbit...');
    
    for (const lead of allLeads.slice(0, 3)) {
      if (lead.company) {
        const domain = extractDomainFromCompany(lead.company);
        const enrichData = await enrichWithClearbit(domain);
        
        if (enrichData) {
          lead.companyDescription = enrichData.description;
          lead.companyEmployees = enrichData.employees;
          if (!lead.phone) lead.phone = enrichData.phone;
          if (!lead.linkedin) lead.linkedin = enrichData.linkedin;
        }
      }
    }
  }

  return allLeads;
}

