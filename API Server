app.post('/api/leads/search', async (req, res) => {
  try {
    const { jobTitle, industry, company, location, keywords } = req.body;

    if (!jobTitle && !company && !location && !keywords) {
      return res.status(400).json({ 
        error: 'Please provide at least one search criteria' 
      });
    }

    const criteria = { jobTitle, industry, company, location, keywords };
    console.log('Search criteria:', criteria);

    // 使用免費API搜尋
    let leads = await searchLeadsWithFreeAPIs(criteria);

    // 如果沒有配置API或沒有結果，返回範例資料
    if (leads.length === 0) {
      console.log('No results from APIs, generating sample data...');
      leads = generateSampleLeads(criteria);
    }

    // 按匹配分數排序
    leads.sort((a, b) => b.matchScore - a.matchScore);

    res.json({
      success: true,
      count: leads.length,
      leads: leads,
      criteria: criteria,
      sources: [...new Set(leads.map(l => l.source))]
    });

  } catch (error) {
    console.error('Search error:', error);
    res.status(500).json({ 
      error: 'Failed to search leads',
      message: error.message 
    });
  }
});

